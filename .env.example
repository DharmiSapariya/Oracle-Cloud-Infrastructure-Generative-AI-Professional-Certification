# Copy to .env and fill in. NEVER commit .env.
# --- OCI authentication (uses ~/.oci/config by default) ---
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# --- OCI Generative AI ---
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace_me
# Region endpoint for the Inference API (the course demo used Frankfurt)
OCI_GENAI_ENDPOINT=https://inference.generativeai.eu-frankfurt-1.oci.oraclecloud.com
# Model IDs. The course recorded cohere.command-r-plus / cohere.embed-multilingual-v3.0,
# but Oracle has since retired those on-demand. Check docs.oracle.com for current IDs.
OCI_CHAT_MODEL_ID=cohere.command-a-03-2025
OCI_EMBED_MODEL_ID=cohere.embed-v4.0

# --- Oracle Database 23ai / Autonomous Database (RAG lab) ---
DB_USER=ADMIN
DB_PASSWORD=replace_me
DB_DSN=replace_me_with_connection_string
VECTOR_TABLE_NAME=RAG_DOCS

# --- Fine-tuned model served from a hosting cluster (m2 script 08) ---
OCI_CUSTOM_ENDPOINT_ID=ocid1.generativeaiendpoint.oc1..replace_me
# Only needed for custom endpoints: COHERE, COHEREV2 or GENERIC (matches the base model family)
OCI_CHAT_API_FORMAT=

# --- GenAI Agents (runtime client) ---
OCI_AGENT_ENDPOINT_ID=ocid1.genaiagentendpoint.oc1..replace_me
OCI_AGENT_RUNTIME_ENDPOINT=https://agent-runtime.generativeai.eu-frankfurt-1.oci.oraclecloud.com
