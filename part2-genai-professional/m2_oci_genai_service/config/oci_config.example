# Template for ~/.oci/config  (course demo: "Config File Setup & Authentication")
# Generate real values in the console: Profile -> My profile -> API keys -> Add API key
# (generate an RSA key pair in PEM format, download the private key, copy the config preview).
# NEVER commit your real config or private key.
[DEFAULT]
user=ocid1.user.oc1..replace_me
fingerprint=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
tenancy=ocid1.tenancy.oc1..replace_me
region=eu-frankfurt-1
key_file=~/.oci/oci_api_key.pem
